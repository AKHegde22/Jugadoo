# ===========================
# JugaadReasoning-1K API Keys
# ===========================
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.

# LLM Provider Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AI...

# Open-Weights Providers (optional — for API-hosted open models)
TOGETHER_API_KEY=...
FIREWORKS_API_KEY=...
DEEPSEEK_API_KEY=...

# Data Source Keys (optional)
YOUTUBE_API_KEY=...

# Judge Configuration
JUDGE_MODEL_PROVIDER=openai
JUDGE_MODEL_NAME=gpt-4o
